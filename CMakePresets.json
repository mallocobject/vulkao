{
  "version": 6,
  "configurePresets": [
    {
      "name": "clangd",
      "displayName": "clangd compile database (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clangd",
      "configurePreset": "clangd"
    }
  ]
}
